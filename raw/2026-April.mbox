results[i, "geometric mean"] <- try (prod (na.omit(var))^(1 / length
(na.omit(var))))
results[i, "interquantile mean"] <- try (sum(quantile(var, probs=c(0.25),
na.rm=T), quantile(var, probs=c(0.75), na.rm=TRUE)) / 2)
results[i, "harmonic mean"] <- try (1 / mean(1 / na.omit(var)))
results[i, "median"] <- try (median (var, na.rm=TRUE))
try ({
range <- try (range (var, na.rm=TRUE))
results[i, "min"] <- range[1]
results[i, "max"] <- range[2]
})
results[i, "standard deviation"] <- try (sd (var, na.rm=TRUE))
