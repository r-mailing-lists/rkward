These are available on r-universe (
https://github.com/AlfCano/alfcano.r-universe.dev and
https://alfcano.r-universe.dev/builds) through this command:

```
local({
  # 1. List of packages
  pkgs <- c(
    "rk.aiken.v", "rk.apyramid", "rk.bayesian", "rk.cartographr",
"rk.class.lists",
    "rk.codebook", "rk.cSplit", "rk.ctables", "rk.data.wrangling",
"rk.dates",
    "rk.doe", "rk.dplyr", "rk.flextable", "rk.forcats", "rk.ggsurvey",
    "rk.googlesheets4", "rk.gsub.sub", "rk.gtsummary", "rk.janitor",
"rk.lavaan",
    "rk.lookup", "rk.lubridate", "rk.mult.resp", "rk.names.labels",
"rk.pivot.reshape",
    "rk.psych", "rk.qcc", "rk.questionr", "rk.shiny.plugins",
"rk.six.sigma",
    "rk.stringr", "rk.survey.design", "rk.survey.wrangling", "rk.survival",
    "rk.svyplot", "rk.tidyr", "rk.transpose.df", "rk.weibull",
"rk.storytelling.data",
    "rk.storytelling.survey", "rk.fastdummies", "rk.ddi.import",
    "rk.rnaturalearth", "rk.map.localities", "rk.map.globalities",
    "rk.text.mining", "rk.correspondence", "rk.rmd", "rk.network.graphs",
    "rk.exporter", "rk.tidycensus", "rk.effect.sizes", "rk.interactive.bi",
    "rk.word.cloud", "rk.ipumsr", "rk.gganimate", "rk.case.if",
"rk.grateful"
  )

  # 2. Configure R tu use personal repository
  options(repos = c(
    alfcano = "https://alfcano.r-universe.dev",
    CRAN = "https://cloud.r-project.org"
  ))

  # 3. Optimized installation
  message(">>> Instalando desde alfcano.r-universe.dev...")
  install.packages(pkgs)
})
```

If you only want to install specific plugins, add the repository to your
options and install as usual:

```
# Enable the universe
options(repos = c(
  alfcano = "https://alfcano.r-universe.dev",
  CRAN = "https://cloud.r-project.org"
))

# Install specific packages
install.packages("rk.janitor")
install.packages("rk.rnaturalearth")
```

Or individual packages:

```
# Install 'rk.exporter' in R:
install.packages('rk.exporter', repos = c('https://alfcano.r-universe.dev',
'https://cloud.r-project.org'))
```

